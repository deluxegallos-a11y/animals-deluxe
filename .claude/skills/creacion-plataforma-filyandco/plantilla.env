# ─────────────────────────────────────────────────────────────
#  PLANTILLA .env para una INSTANCIA NUEVA (clonar FilyandCo)
#  Copiar a .env.local y rellenar. SIN esto → MODO DEMO (mock, sin login).
#  Genera cada secreto con: openssl rand -hex 32   (BOT_API_KEY: -hex 24)
#  NO reutilizar secretos entre instancias distintas.
# ─────────────────────────────────────────────────────────────

# --- Base de datos (Supabase → Settings → Database) ---
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres   # pooler 6543 (app)
DIRECT_DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres  # directo 5432 (migración/seed)

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=product-images

# --- Seguridad de la API ---
BRIDGE_TOKEN=            # x-bridge-token que el bot envía a /api/ai/*        (openssl rand -hex 32)
BOT_API_KEY=            # x-api-key para GET /api/products/search             (openssl rand -hex 24)
ENCRYPTION_KEY=         # AES-256 para cifrar credenciales — 64 chars hex     (openssl rand -hex 32)
UCHAT_WEBHOOK_TOKEN=    # verifica el webhook entrante de UChat               (openssl rand -hex 32)

# --- URLs públicas ---
NEXT_PUBLIC_SITE_URL=https://TU-DOMINIO.com
NEXT_PUBLIC_WHATSAPP=57XXXXXXXXXX

# --- Shopify Admin API (espejo del catálogo) ---
# Custom app: scopes write_products, write_orders, read_products, read_orders
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# --- Bold (pago anticipado) ---
# Authorization: x-api-key <BOLD_API_KEY>. Webhook a /api/webhooks/bold verificado con el secret.
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# --- UChat (envío saliente al cliente) ---
# Confirma UCHAT_SEND_PATH en el Swagger de tu cuenta (www.uchat.com.au/api)
UCHAT_API_TOKEN=
UCHAT_API_BASE=https://www.uchat.com.au/api
UCHAT_SEND_PATH=/subscriber/send-content

# --- Rate limit distribuido (opcional · Upstash Redis) ---
# Si falta, cae a in-memory por-lambda (falla abierto, no bloquea ventas).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Wompi (DESACTIVADO · reemplazado por Bold, se deja por compatibilidad) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
